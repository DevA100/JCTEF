# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel or another host, add the same variables in the project settings.

# Cloudinary cloud that hosts the homepage hero photos (not a secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dreezy

# Brevo API key: Brevo > Settings (SMTP & API) > API keys > Generate a new API key.
BREVO_API_KEY=

# Contact form (/contact)
# Where messages are delivered.
CONTACT_TO_EMAIL=info@jctef.org
# The "from" address. Must be a verified sender on the jctef.org domain in Brevo.
CONTACT_FROM_EMAIL=website@jctef.org

# Newsletter
# The ID of the Brevo list (Contacts > Lists; the number in the ID column).
BREVO_LIST_ID=
# Double opt-in (recommended): the ID of the Brevo double opt-in confirmation
# template. Leave empty to add subscribers straight to the list instead.
BREVO_DOI_TEMPLATE_ID=
# Where people land after confirming. Defaults to https://jctef.org/newsletter/confirmed
BREVO_DOI_REDIRECT_URL=
