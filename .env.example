# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel or another host, add the same variables in the project settings.

# Cloudinary cloud that hosts the homepage hero photos (not a secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dreezy

# Brevo API key: Brevo > Settings (SMTP & API) > API keys > Generate a new API key.
BREVO_API_KEY=

# Contact form (/contact)
# Where messages are delivered.
CONTACT_TO_EMAIL=info@jctef.org
# The "from" address. Must be a verified sender on the jctef.org domain in Brevo.
CONTACT_FROM_EMAIL=info@jctef.org

# Newsletter (Brevo double opt-in)
# The ID of the Brevo list (Contacts > Lists; the number in the ID column).
BREVO_LIST_ID=
# The ID of the confirmation email template (see emails/brevo/README.md).
BREVO_DOI_TEMPLATE_ID=

# The site's own address, used for the link in the confirmation email.
# http://localhost:3000 locally; https://jctef.org in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Volunteer form (/get-involved#volunteer-form)
# Where applications are sent (defaults to info@jctef.org).
VOLUNTEER_TO_EMAIL=info@jctef.org
# The emails themselves are emails/brevo/volunteer-*.html, sent from CONTACT_FROM_EMAIL.
# Brevo list that keeps a record of every applicant (optional but recommended).
BREVO_VOLUNTEER_LIST_ID=

# Partnership enquiry form (/get-involved#partner-form)
# Where enquiries go; also shown on the page as "Prefer email? Write to …".
PARTNER_TO_EMAIL=partner@jctef.org
# Brevo list that keeps a record of every enquirer (optional but recommended).
BREVO_PARTNER_LIST_ID=

# Google Sheet copy of every volunteer, partner and contact submission
# (see integrations/google-sheets/README.md). Leave empty to switch it off.
# The Apps Script web app URL (ends in /exec).
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match SECRET in the script's Script Properties. Never commit the real one.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Cloudflare Turnstile (spam protection on all four forms).
# Cloudflare dashboard > Turnstile > Add widget (hostnames: jctef.org, www.jctef.org).
# Leave both empty to switch it off (local development). It's only checked when both are set.
# The site key is public (it's built into the page); the secret key never leaves the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: salt for hashing IP addresses in the form rate limiter (Netlify Blobs).
# Any long random string. Leave empty to use the default.
RATE_LIMIT_SALT=

# PostHog analytics (EU Cloud). Project settings > Project token (starts "phc_").
# It's public by design (built into the page). Leave empty to switch analytics
# off: nothing loads, and no cookie banner is shown (local development).
# Set it for the Production context only on Netlify: PostHog's proxy doesn't
# work on *.netlify.app deploy previews. See "Analytics" in README.md.
NEXT_PUBLIC_POSTHOG_KEY=
